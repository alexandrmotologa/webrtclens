{
  "name": "webrtclens",
  "version": "1.0.0",
  "description": "Interactive WebRTC media and signaling workbench with visual SDP diffing, real STUN/TURN UDP/TCP/TLS probing, ICE topology waterfall, and network chaos loopback.",
  "type": "module",
  "bin": {
    "webrtclens": "./bin/webrtclens.js"
  },
  "main": "dist/server/app.js",
  "types": "dist/server/app.d.ts",
  "scripts": {
    "build": "tsc",
    "build:web": "npm run build --prefix web",
    "build:all": "npm run build && npm run build:web",
    "dev:server": "tsx watch src/cli.ts serve --port 3000",
    "dev:web": "npm run dev --prefix web",
    "test": "node --test dist/**/*.test.js || node --test tests/*.test.ts --loader tsx",
    "test:ts": "tsx --test tests/**/*.test.ts",
    "cli": "tsx src/cli.ts",
    "start": "node bin/webrtclens.js serve"
  },
  "keywords": [
    "webrtc",
    "sdp",
    "stun",
    "turn",
    "ice",
    "rtp",
    "network-testing",
    "chaos-engineering",
    "visual-diff",
    "diagnostics"
  ],
  "author": "Alexandr Motologa",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.1.0",
    "commander": "^13.1.0",
    "fastify": "^5.2.0",
    "picocolors": "^1.1.1",
    "sdp-transform": "^2.14.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/sdp-transform": "^2.4.9",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
